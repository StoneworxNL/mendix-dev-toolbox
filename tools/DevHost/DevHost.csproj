<Project Sdk="Microsoft.NET.Sdk">
  <!-- Serves the toolbox through the extension's own request handler, so the UI can be tried in a browser without Studio Pro. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DevToolbox\DevToolbox.csproj" />
    <PackageReference Include="Mendix.StudioPro.ExtensionsAPI" Version="11.12.0" />
  </ItemGroup>
</Project>
